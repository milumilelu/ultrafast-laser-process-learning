[importlinter]
include_external_packages = true
root_packages =
    packages
    ultrafast_bo
    ultrafast_cfa
    ultrafast_domain
    ultrafast_e2p
    ultrafast_ingestion
    ultrafast_interaction
    ultrafast_physics
    ultrafast_reconstructibility
    ultrafast_shared

[importlinter:contract:cfa-leaf]
name = CFA must not depend on BO/Domain/Contracts
type = forbidden
source_modules =
    ultrafast_cfa
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain

[importlinter:contract:interaction-leaf]
name = Interaction must not depend on BO/Domain/Contracts
type = forbidden
source_modules =
    ultrafast_interaction
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain

[importlinter:contract:reconstructibility-leaf]
name = Reconstructibility must not depend on BO/Domain/Contracts
type = forbidden
source_modules =
    ultrafast_reconstructibility
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain

[importlinter:contract:ingestion-leaf]
name = Ingestion must not depend on project packages
type = forbidden
source_modules =
    ultrafast_ingestion
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain
    ultrafast_e2p
    ultrafast_physics
    ultrafast_shared

[importlinter:contract:physics-leaf]
name = Physics must not depend on other project packages
type = forbidden
source_modules =
    ultrafast_physics
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain
    ultrafast_e2p

[importlinter:contract:domain-leaf]
name = Domain must not depend on other project packages
type = forbidden
source_modules =
    ultrafast_domain
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_e2p
    ultrafast_physics
    ultrafast_shared

[importlinter:contract:e2p-leaf]
name = E2P must not depend on other project packages
type = forbidden
source_modules =
    ultrafast_e2p
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain
    ultrafast_physics
    ultrafast_shared

[importlinter:contract:shared-leaf]
name = Shared must not depend on other project packages
type = forbidden
source_modules =
    ultrafast_shared
forbidden_modules =
    packages.process_contracts
    ultrafast_bo
    ultrafast_domain
    ultrafast_e2p
    ultrafast_physics

[importlinter:contract:contracts-leaf]
name = process_contracts must not depend on project packages
type = forbidden
source_modules =
    packages.process_contracts
forbidden_modules =
    ultrafast_bo
    ultrafast_domain
    ultrafast_e2p
    ultrafast_physics
    ultrafast_shared

[importlinter:contract:bo-not-on-domain-physics]
name = BO must not depend on Domain/Physics/Contracts
type = forbidden
source_modules =
    ultrafast_bo
forbidden_modules =
    packages.process_contracts
    ultrafast_domain
    ultrafast_physics

[importlinter:contract:e2p-not-on-scientific-computation]
name = Typed E2P must not depend on scientific computation
type = forbidden
source_modules =
    packages.e2p
forbidden_modules =
    packages.scientific_computation

[importlinter:contract:scientific-computation-not-on-e2p]
name = Scientific computation must not depend on E2P
type = forbidden
source_modules =
    packages.scientific_computation
forbidden_modules =
    packages.e2p
    ultrafast_e2p
